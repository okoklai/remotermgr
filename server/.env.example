# --- Database -------------------------------------------------------------
# Default is a local SQLite file, which is enough to get running immediately.
# To put the database in the cloud, uncomment ONE of these lines and fill it in.
# The tables are created automatically on first start; no schema migration tool needed.
#
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@CLOUD-HOST:3306/remotemgr?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@CLOUD-HOST:5432/remotemgr
# DATABASE_URL=sqlite:////home/acaiplus/remotemgr/data/remotemgr.db

# --- HTTP ------------------------------------------------------------------
BIND_HOST=0.0.0.0
BIND_PORT=8800
# Comma-separated allowed CORS origins, or * for a trusted intranet.
CORS_ORIGINS=*

# --- First boot ------------------------------------------------------------
# Used only when rm_users is empty. Leave BOOTSTRAP_PASSWORD empty to have a
# random password generated into data/initial_admin.txt (mode 0600).
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=

# --- Sessions & security ---------------------------------------------------
TOKEN_TTL=43200
TICKET_TTL=60
# MASTER_KEY and SECRET_KEY are generated on first run into data/*.key (0600).
# Back them up: losing master.key means stored passwords cannot be decrypted.
# MASTER_KEY=<urlsafe-base64 of 32 bytes>
# SECRET_KEY=<urlsafe-base64 of 32 bytes>

# --- Behaviour -------------------------------------------------------------
# Default timeout the WebUI forwards to the LOCAL Agent's POST /probe.
# The server itself does not probe hosts; PROBE_WORKERS has been removed.
PROBE_TIMEOUT_MS=500
WOL_BROADCAST=255.255.255.255
AGENT_PORT=17860
